# Copy to .env and fill in. Never commit your real .env.
# Provide a key for at least one provider (both is fine).
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Per-task LLM provider routing (default: anthropic). Lets resume tailoring run on Claude
# while scoring/finding run on OpenAI, or any mix. Values: anthropic | openai
# JOB_AGENT_PROVIDER=anthropic            # global default for all LLM tasks
# JOB_AGENT_TAILOR_PROVIDER=anthropic     # the apply/tailor agent loop
# JOB_AGENT_SCORE_PROVIDER=openai         # the resume scorer
# JOB_AGENT_FIND_PROVIDER=openai          # the finder agent loop
# Per-provider model overrides:
# JOB_AGENT_ANTHROPIC_MODEL=claude-opus-4-8
# JOB_AGENT_OPENAI_MODEL=gpt-4o

# Optional: legacy single-model override
# JOB_AGENT_MODEL=claude-sonnet-4-6

# Optional: a persistent Chrome profile dir so you stay logged in to job sites.
# The agent never sees your passwords — you log in once in this profile.
# JOB_AGENT_USER_DATA_DIR=/Users/you/.job-applier-profile
